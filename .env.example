# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored; never commit real keys.

# Supabase project (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Bypasses Row Level Security — keep it secret, never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only. Any long random string; used to hash IPs for submission rate limiting.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INCIDENT_RATE_LIMIT_SECRET=replace-with-a-long-random-string
