# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored; never commit real keys.

# Supabase project (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Bypasses Row Level Security — keep it secret, never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only. Any long random string; used to hash IPs for rate limiting
# (submissions, staff login, and the AI assistant's chat and voice routes).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INCIDENT_RATE_LIMIT_SECRET=replace-with-a-long-random-string

# Server-only. Aminiya Assistant chat (https://console.groq.com/keys).
GROQ_API_KEY=your-groq-api-key
# Optional. Defaults to openai/gpt-oss-120b.
GROQ_MODEL=

# Server-only. NaijaLLM speech service, used for voice input and read-aloud.
NAIJA_ASR_KEY=your-naija-asr-key

# Optional, local QA only. "true" mixes sample civic events (dated relative to
# today) into the public calendar and home hero. Never written to the database.
NEXT_PUBLIC_DEMO_CIVIC_EVENTS=

# Optional, local QA only. "true" shows a labelled sample in the home page
# "Live in Gombe" strip until real promises or issues are published.
NEXT_PUBLIC_DEMO_PROOF=
